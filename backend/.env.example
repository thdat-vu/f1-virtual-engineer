GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase (auth + persistence) -------------------------------------------
# Project URL — Project Settings → Data API → Project URL.
# Don't add a trailing slash and don't include /auth/v1; the backend appends
# the JWKS path itself when verifying tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key — Project Settings → API Keys → secret keys.
# Used by the backend for PostgREST writes; bypasses RLS, so the caller's
# user_id is always derived from a verified JWT `sub` claim, never trusted
# from request bodies.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Legacy HS256 JWT secret — Project Settings → API Keys → Legacy anon/service.
# Optional. Only used as a fallback when a project still emits HS256 tokens.
# Projects on the new asymmetric JWT Signing Keys (ES256) verify via JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json instead.
SUPABASE_JWT_SECRET=

# Postgres connection string — only used by backend/scripts/apply_migrations.py.
# Project Settings → Database → Connection string → URI (transaction pooler).
SUPABASE_DB_URL=

# --- Caches ------------------------------------------------------------------
FASTF1_CACHE_DIR=backend/data
# Shared Redis cache for FastF1 helper outputs (issue #100 slice D).
# Leave blank to use in-process cache only (slice B).
# Example: redis://localhost:6379/0
REDIS_URL=
