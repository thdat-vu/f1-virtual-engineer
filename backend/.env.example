GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
# Service-role key (Project Settings → API → service_role). Used by the
# backend to insert /analyze history rows; bypasses RLS, so callers must
# only pass user ids derived from a verified JWT `sub` claim.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# JWT secret (Project Settings → API → JWT Settings). Used to verify
# Supabase-issued bearer tokens on /analyze and /analyze/history.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
FASTF1_CACHE_DIR=backend/data
