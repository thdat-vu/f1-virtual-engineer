GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase (auth + persistence) -------------------------------------------
# Project URL — Project Settings → Data API → Project URL.
# Don't add a trailing slash and don't include /auth/v1; the backend appends
# the JWKS path itself when verifying tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key — Project Settings → API Keys → secret keys.
# Used by the backend for PostgREST writes; bypasses RLS, so the caller's
# user_id is always derived from a verified JWT `sub` claim, never trusted
# from request bodies.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Legacy HS256 JWT secret — Project Settings → API Keys → Legacy anon/service.
# Optional. Only used as a fallback when a project still emits HS256 tokens.
# Projects on the new asymmetric JWT Signing Keys (ES256) verify via JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json instead.
SUPABASE_JWT_SECRET=

# Postgres connection string — only used by backend/scripts/apply_migrations.py.
# Project Settings → Database → Connection string → URI (transaction pooler).
SUPABASE_DB_URL=

# --- Caches ------------------------------------------------------------------
FASTF1_CACHE_DIR=backend/data
# Shared Redis cache for FastF1 helper outputs (issue #100 slice D).
# Leave blank to use in-process cache only (slice B).
#
# Local dev (Redis running on host):
#   redis://127.0.0.1:6379/0
# Docker compose (recommended — see docker-compose.staging.yml):
#   redis://:${REDIS_PASSWORD}@redis:6379/0
# Production: NEVER expose Redis on a public port without a strong
# password. An open Redis is trivially turned into RCE via
# `CONFIG SET dir` → arbitrary file write → cron / SSH key.
REDIS_URL=

# Strong random password used by the redis service in compose.
# Must be set whenever you bring up docker-compose.staging.yml — the
# compose file refuses to start without it. 32+ random bytes recommended:
#   openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
REDIS_PASSWORD=

# Optional: rename Redis admin commands so even an authed client can't
# flip persistence settings and dump an RDB to a writable path. Defaults
# in docker-compose.staging.yml are good enough; only override if you
# integrate a tool that needs the original names.
REDIS_CONFIG_RENAME=
REDIS_FLUSHALL_RENAME=
REDIS_FLUSHDB_RENAME=
