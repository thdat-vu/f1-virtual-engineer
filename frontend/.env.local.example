NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (frontend) — populate from your Supabase project's API settings.
# Both vars are public (NEXT_PUBLIC_*); the anon key is meant to be exposed.
# Leave blank to keep auth disabled — Mission Control still works anonymously.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional canonical origin override for the auth callback. Behind a
# reverse proxy that doesn't forward Host / X-Forwarded-Host correctly,
# Next sees the container's listen address (0.0.0.0:3000) and bounces
# the user to https://0.0.0.0:3000 after Google login. Set this to the
# public URL on prod (e.g. https://f1-virtual-engineer.duckdns.org) and
# the route handler uses it directly. Leave blank in dev — request.url's
# origin is fine on localhost.
NEXT_PUBLIC_SITE_URL=

# Admin gating for /admin observability page (#130).
# Paste the Supabase user.id (uuid) of the single account allowed to view
# /metrics. Leave blank to disable the page (any signed-in user gets a 403-style
# block screen). Public env var by design — the gate is UX, not a secret;
# /metrics itself is unauthenticated and trivially fetchable.
NEXT_PUBLIC_ADMIN_USER_ID=
