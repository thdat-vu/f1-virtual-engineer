NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (frontend) — populate from your Supabase project's API settings.
# Both vars are public (NEXT_PUBLIC_*); the anon key is meant to be exposed.
# Leave blank to keep auth disabled — Mission Control still works anonymously.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
